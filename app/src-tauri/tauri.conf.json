{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "gamma",
  "version": "0.1.0",
  "identifier": "com.su3labs.gamma",
  "build": {
    "beforeDevCommand": "npm --prefix ../ui run dev",
    "beforeBuildCommand": "",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "gamma",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 620,
        "backgroundColor": "#0c0e12",
        "dragDropEnabled": false,
        "label": "main",
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:* ws://127.0.0.1:* ipc: http://ipc.localhost; img-src 'self' data: blob: http://127.0.0.1:*; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "appimage",
      "deb",
      "rpm",
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "category": "DeveloperTool",
    "shortDescription": "Design, simulate and test photonic integrated circuits",
    "longDescription": "gamma is an open-source workspace for photonic integrated circuits: layout, 3-D, simulation set-up, GPU FDTD runs with lightsim (locally or on remote GPU servers) and results, built for AI agents.",
    "copyright": "Copyright (c) 2026 SU3 Labs",
    "licenseFile": "../../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/gamma"
    ],
    "resources": {
      "../ui/dist/": "ui/"
    },
    "macOS": {
      "minimumSystemVersion": "13.0",
      "hardenedRuntime": true,
      "entitlements": "entitlements.plist"
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "git",
          "openssh-client"
        ],
        "section": "science"
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "gtk3",
          "git",
          "openssh-clients"
        ]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "REPLACED_BY_SCRIPTS",
      "endpoints": [
        "https://updates.invalid/gamma/{{target}}/{{arch}}/{{current_version}}"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}